# Entorno de ejecución de la aplicación: development | production
APP_ENV=development

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Postgres (docker-compose.yml, servicio "db")
# Puerto 5433 en el host (no 5432): evita el conflicto con un PostgreSQL nativo
# de Windows que ya pueda estar escuchando en el puerto por defecto.
DATABASE_URL=postgresql://compass:compass@localhost:5433/compass

# Redis (docker-compose.yml, servicio "redis")
REDIS_URL=redis://localhost:6379/0

# OpenRouter (Fase 3) -- OBLIGATORIA. Sin ella el proceso no arranca, y es
# deliberado: es la única clave sin la cual Compass no puede hacer lo que
# promete, porque el agente no tendría a quién preguntar. Es gratuita.
#
# Clave de openrouter.ai, usada por el agente
# analista de pliegos para llamar a su modelo de extracción
# (nvidia/nemotron-3-super-120b-a12b:free, decidido en la 3.4 contra un golden
# set real -- ver docs/phases/phase3/subphases/phase3.4.md) vía su API
# compatible con OpenAI.
OPENROUTER_API_KEY=

# Langfuse Cloud (Fase 4) -- OPCIONAL. Trazas y coste real por análisis.
#
# Compass funciona igual sin esto: si faltan las claves, el cliente se
# construye con las trazas desactivadas y cada observación es un no-op. Está
# aquí porque es como este proyecto vigila lo que cuestan sus llamadas al
# modelo, no porque la herramienta lo necesite -- si solo quieres probarla,
# déjalo en blanco y olvídate.
#
# Para activarlo: cuenta gratuita en cloud.langfuse.com y las dos claves de
# un proyecto de ahí (ver docs/phases/phase4/phase4.md sobre por qué Cloud y
# no self-hosted). Hacen falta las dos; con una sola sigue desactivado.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Host de la API. Por defecto, la región EU. Si el proyecto se creó en la
# región US, cambiar a https://us.cloud.langfuse.com.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Orígenes permitidos para llamar a la API desde el navegador (Fase 5). El
# dashboard de Next.js corre en http://localhost:3000 en desarrollo. Lista JSON
# si hay más de uno: ["http://localhost:3000","https://midominio.com"].
CORS_ORIGINS=["http://localhost:3000"]
